{
  "name": "vscode-terribuild",
  "displayName": "Terribuild support for VS Code",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:terribuild.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terribuild",
          "title": "Terribuild",
          "icon": "resources/terribuild.svg"
        }
      ]
    },
    "views": {
      "terribuild": [
        {
          "id": "terribuild-binaries",
          "name": "Terribuild",
          "icon": "resources/terribuild.svg",
          "contextualTitle": "Terribuild binaries"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "terribuild.buildBinary",
          "group": "inline",
          "when": "view == terribuild-binaries"
        },
        {
          "command": "terribuild.debugBinary",
          "group": "inline",
          "when": "view == terribuild-binaries"
        }
      ]
    },
    "commands": [
      {
        "command": "terribuild.buildBinary",
        "title": "Build",
        "category": "Terribuild"
      },
      {
        "command": "terribuild.debugBinary",
        "title": "Debug",
        "category": "Terribuild"
      },
      {
        "command": "terribuild.selectedBinary",
        "title": "Currently selected binary",
        "category": "Terribuild"
      },
      {
        "command": "terribuild.selectBinary",
        "title": "Select binary",
        "category": "Terribuild"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8"
  }
}