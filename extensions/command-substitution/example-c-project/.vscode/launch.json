{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch current executable",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:my-extension.getExecutablePath}/${command:my-extension.getExecutableName}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:my-extension.getExecutablePath}",
            "environment": [],
            "externalConsole": false,
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Set so lib search paths",
                    "text": "-gdb-set environment LD_LIBRARY_PATH ${command:my-extension.getAdditionalSOLibPaths}",
                    "ignoreFailures": false
                }
            ]
        }

    ]
}