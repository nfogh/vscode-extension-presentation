{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active executable",
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",
				"-fPIC",
				"${command:my-extension.getOtherCompileArgs}",
				"-g",
				"${command:my-extension.getFilesToCompile}",
				"-o",
				"${command:my-extension.getExecutableName}"
			],
			"options": {
				"cwd": "${command:my-extension.getExecutablePath}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: /usr/bin/g++"
		}
	]
}