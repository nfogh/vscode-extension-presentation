{
  "name": "my-extension",
  "displayName": "My Extension",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "my-extension.getFilesToCompile",
        "title": "Get Files To Compile"
      },
      {
        "command": "my-extension.getExecutableName",
        "title": "Get executable name"
      },
      {
        "command": "my-extension.getExecutablePath",
        "title": "Get executable path"
      },
      {
        "command": "my-extension.getOtherCompileArgs",
        "title": "Get other compile args"
      },
      {
        "command": "my-extension.getAdditionalSOLibPaths",
        "title": "Get additional so lib paths"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
